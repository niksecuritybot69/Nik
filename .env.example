# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Optional: public channel username (with @) that users must join to post.
# Bot must be an admin of this channel to check membership.
FORCE_JOIN_CHANNEL=@yourchannel

# Postgres connection string for durable storage (filters, blacklist, stats,
# night mode settings, etc.). Without this, the bot falls back to a local
# JSON file that does NOT survive Render restarts/redeploys.
# On Render: create a free "PostgreSQL" instance, then copy its "Internal
# Database URL" (or "External Database URL" if connecting from elsewhere)
# into this variable in your Background Worker's environment settings.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: channel where moderation logs get sent (bans, warns, gbans,
# edit/anti-forward deletions, tbans). Use the channel's numeric ID
# (e.g. -1001234567890) and make sure the bot is an admin of that channel.
LOG_CHANNEL_ID=-1001234567890

# Comma-separated Telegram user IDs allowed to run /gban and /ungban
# (global ban across every group the bot is in). Keep this short — it's
# meant for bot owners, not regular group admins.
OWNER_IDS=2096985880

# Comma-separated Telegram user IDs allowed to run /verify (posting a
# verified UPI/crypto address). Separate from OWNER_IDS since you may want
# a different, possibly larger, set of trusted people here.
VERIFY_ADMINS=2096985880
